---
import type { SimpleCrudConfig } from '../../lib/portal/simple-crud';

interface Props {
  config: SimpleCrudConfig;
  rows: Record<string, any>[];
}

const { config, rows } = Astro.props;
const allowAdd = config.allowAdd !== false;
const allowDelete = config.allowDelete !== false;

function displayValue(row: Record<string, any>, key: string): string {
  const v = row[key];
  return v === null || v === undefined ? '' : String(v);
}
---
<div class="portal-card">
  <h2>{config.pageTitle}</h2>
  <div class="portal-list">
    {rows.map((row, i) => (
      <div
        class:list={['portal-list-row', { 'is-disabled': config.visibilityColumn ? !row[config.visibilityColumn] : false }]}
        style="align-items: flex-start;"
      >
        {config.orderColumn && (
          <div class="portal-order-btns">
            <form method="POST" class="portal-inline-form">
              <input type="hidden" name="action" value="move" />
              <input type="hidden" name="id" value={String(row.id)} />
              <input type="hidden" name="direction" value="up" />
              <button type="submit" disabled={i === 0} aria-label="Move up">▲</button>
            </form>
            <form method="POST" class="portal-inline-form">
              <input type="hidden" name="action" value="move" />
              <input type="hidden" name="id" value={String(row.id)} />
              <input type="hidden" name="direction" value="down" />
              <button type="submit" disabled={i === rows.length - 1} aria-label="Move down">▼</button>
            </form>
          </div>
        )}

        {config.previewField && row[config.previewField] && (
          <img class="portal-list-thumb" src={displayValue(row, config.previewField)} alt="" loading="lazy" />
        )}

        <form method="POST" class="portal-list-body" enctype="multipart/form-data">
          <input type="hidden" name="action" value="edit" />
          <input type="hidden" name="id" value={String(row.id)} />
          <div class="portal-form-grid">
            {config.fields.map((field) => (
              <div class:list={['portal-field', { 'is-wide': field.wide }]}>
                <label>{field.label}</label>
                {field.type === 'textarea' ? (
                  <textarea name={field.key} required={field.required}>{displayValue(row, field.key)}</textarea>
                ) : field.type === 'select' ? (
                  <select name={field.key} required={field.required}>
                    {(field.options ?? []).map((opt) => (
                      <option value={opt} selected={displayValue(row, field.key) === opt}>{opt}</option>
                    ))}
                  </select>
                ) : field.type === 'checkbox' ? (
                  <label class="portal-checkbox">
                    <input type="checkbox" name={field.key} checked={!!row[field.key]} />
                    {field.placeholder ?? 'Enabled'}
                  </label>
                ) : field.type === 'image' ? (
                  <>
                    {row[field.key] && (
                      <img
                        src={displayValue(row, field.key)}
                        alt=""
                        style="width:48px;height:48px;object-fit:cover;border-radius:6px;margin-bottom:4px;"
                      />
                    )}
                    <input name={field.key} type="text" value={displayValue(row, field.key)} placeholder="/images/... or paste a URL" />
                    <input name={`${field.key}_upload`} type="file" accept="image/*" style="font-size:0.76rem; margin-top:4px;" />
                  </>
                ) : (
                  <input
                    type={field.type === 'number' ? 'number' : field.type}
                    name={field.key}
                    required={field.required}
                    value={displayValue(row, field.key)}
                    placeholder={field.placeholder}
                    min={field.min}
                    max={field.max}
                  />
                )}
              </div>
            ))}
          </div>
          <div class="portal-actions">
            <button type="submit" class="portal-btn portal-btn-sm">Save</button>
          </div>
        </form>

        {allowDelete && (
          <form method="POST" class="portal-inline-form" onsubmit="return confirm('Delete this item?')">
            <input type="hidden" name="action" value="delete" />
            <input type="hidden" name="id" value={String(row.id)} />
            <button type="submit" class="portal-btn-ghost portal-btn-sm portal-btn-danger">Delete</button>
          </form>
        )}
      </div>
    ))}
    {rows.length === 0 && <p class="portal-card-hint">Nothing here yet.</p>}
  </div>
</div>

{allowAdd && (
  <div class="portal-card">
    <h2>{config.addLabel}</h2>
    <form method="POST" enctype="multipart/form-data">
      <input type="hidden" name="action" value="add" />
      <div class="portal-form-grid">
        {config.fields.map((field) => (
          <div class:list={['portal-field', { 'is-wide': field.wide }]}>
            <label>{field.label}</label>
            {field.type === 'textarea' ? (
              <textarea name={field.key} required={field.required} placeholder={field.placeholder}>
                {field.defaultValue !== undefined ? String(field.defaultValue) : ''}
              </textarea>
            ) : field.type === 'select' ? (
              <select name={field.key} required={field.required}>
                {(field.options ?? []).map((opt) => (
                  <option value={opt} selected={field.defaultValue !== undefined && String(field.defaultValue) === opt}>
                    {opt}
                  </option>
                ))}
              </select>
            ) : field.type === 'checkbox' ? (
              <label class="portal-checkbox">
                <input type="checkbox" name={field.key} checked={!!field.defaultValue} />
                {field.placeholder ?? 'Enabled'}
              </label>
            ) : field.type === 'image' ? (
              <>
                <input name={field.key} type="text" placeholder={field.placeholder ?? '/images/... or paste a URL'} />
                <input name={`${field.key}_upload`} type="file" accept="image/*" style="font-size:0.76rem; margin-top:4px;" />
              </>
            ) : (
              <input
                type={field.type === 'number' ? 'number' : field.type}
                name={field.key}
                required={field.required}
                placeholder={field.placeholder}
                value={field.defaultValue !== undefined ? String(field.defaultValue) : undefined}
                min={field.min}
                max={field.max}
              />
            )}
          </div>
        ))}
      </div>
      <div class="portal-actions">
        <button type="submit" class="portal-btn">Add</button>
      </div>
    </form>
  </div>
)}
