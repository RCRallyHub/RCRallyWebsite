---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getPageBySlug } from '../lib/content/pages';
import { getPolicyBySlug } from '../lib/content/policies';
import { renderMarkdown } from '../lib/content/render-markdown';

const page = (await getPageBySlug('cancellation-policy'))!;

const cancellation = (await getPolicyBySlug('cancellation'))!;
const rescheduling = (await getPolicyBySlug('rescheduling'))!;
const venueRules = (await getPolicyBySlug('venue-rules'))!;
const cancellationHtml = await renderMarkdown(cancellation.body);
const reschedulingHtml = await renderMarkdown(rescheduling.body);
const venueRulesHtml = await renderMarkdown(venueRules.body);
---
<Layout
  title={page.data.seoTitle || page.data.title}
  description={page.data.metaDescription || page.data.description || ''}
  ogImage={page.data.ogImage}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Cancellation & Rescheduling', url: '/cancellation-policy' }]}
>
  <PageHero heading={page.data.heading} subheading={page.data.subheading} description={page.data.description} compact />
  <section class="py-16 sm:py-20">
    <div class="container-rc max-w-3xl mx-auto space-y-14">
      <div class="reveal">
        <h2 class="font-display text-2xl uppercase text-rc-white mb-4">Cancellation Policy</h2>
        <p class="text-xs text-rc-silver-dark uppercase tracking-wide mb-6">Last updated: {cancellation.data.lastUpdated}</p>
        <div class="prose-rc" set:html={cancellationHtml} />
      </div>
      <div class="reveal">
        <h2 class="font-display text-2xl uppercase text-rc-white mb-4">Rescheduling Policy</h2>
        <p class="text-xs text-rc-silver-dark uppercase tracking-wide mb-6">Last updated: {rescheduling.data.lastUpdated}</p>
        <div class="prose-rc" set:html={reschedulingHtml} />
      </div>
      <div class="reveal">
        <h2 class="font-display text-2xl uppercase text-rc-white mb-4">Venue Rules</h2>
        <p class="text-xs text-rc-silver-dark uppercase tracking-wide mb-6">Last updated: {venueRules.data.lastUpdated}</p>
        <div class="prose-rc" set:html={venueRulesHtml} />
      </div>
      <div class="card-surface p-7 text-center reveal">
        <p class="text-rc-silver mb-5">Need to cancel or reschedule an existing booking?</p>
        <a href="/contact" class="btn-primary" data-ripple>Contact Us</a>
      </div>
    </div>
  </section>
</Layout>
