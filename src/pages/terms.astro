---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getPageBySlug } from '../lib/content/pages';
import { getPolicyBySlug } from '../lib/content/policies';
import { renderMarkdown } from '../lib/content/render-markdown';

const page = (await getPageBySlug('terms'))!;

const policy = (await getPolicyBySlug('terms'))!;
const policyHtml = await renderMarkdown(policy.body);
---
<Layout
  title={page.data.seoTitle || page.data.title}
  description={page.data.metaDescription || page.data.description || ''}
  ogImage={page.data.ogImage}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Terms & Conditions', url: '/terms' }]}
>
  <PageHero heading={page.data.heading} subheading={page.data.subheading} compact />
  <section class="py-16 sm:py-20">
    <div class="container-rc max-w-3xl mx-auto">
      <p class="text-xs text-rc-silver-dark uppercase tracking-wide mb-8">Last updated: {policy.data.lastUpdated}</p>
      <div class="prose-rc reveal" set:html={policyHtml} />
    </div>
  </section>
</Layout>
