---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import SimpleCrudScreen from '../../components/portal/SimpleCrudScreen.astro';
import { getDb } from '../../lib/db';
import { listRows, handleSimpleCrudAction, type SimpleCrudConfig } from '../../lib/portal/simple-crud';

const db = getDb();
const BASE_PATH = '/portal/addons';

const config: SimpleCrudConfig = {
  table: 'addons',
  orderColumn: 'display_order',
  visibilityColumn: 'published',
  hasSlug: true,
  slugSourceField: 'name',
  cacheKey: 'addons',
  pageTitle: 'Add-ons',
  addLabel: 'Add an Add-on',
  fields: [
    { key: 'name', label: 'Name', type: 'text', required: true },
    { key: 'description', label: 'Description', type: 'textarea', wide: true },
    { key: 'price', label: 'Price', type: 'text', required: true, placeholder: 'e.g. ₱150' },
    { key: 'unit', label: 'Unit', type: 'text', required: true, defaultValue: 'per session' },
    { key: 'icon', label: 'Icon', type: 'select', options: ['paddle', 'ball', 'whistle', 'sparkles'], defaultValue: 'paddle' },
    { key: 'published', label: 'Visible on site', type: 'checkbox', defaultValue: true },
  ],
};

let redirectTarget: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const result = await handleSimpleCrudAction(db, config, form, BASE_PATH);
  redirectTarget = result.redirect;
}
if (redirectTarget) return Astro.redirect(redirectTarget);

const rows = await listRows(db, config);
---
<PortalLayout title="Add-ons" active="addons">
  <SimpleCrudScreen config={config} rows={rows} />
</PortalLayout>
