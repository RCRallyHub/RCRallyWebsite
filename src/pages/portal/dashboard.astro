---
export const prerender = false;

import { getDb } from '../../lib/db';

// context.locals.adminUser is guaranteed set here — src/middleware.ts redirects
// anonymous requests to /portal/login before this page ever renders.
const adminUser = Astro.locals.adminUser!;

const db = getDb();

const COUNT_TABLES: { key: string; label: string; table: string }[] = [
  { key: 'pages', label: 'Pages', table: 'pages' },
  { key: 'events', label: 'Events', table: 'events' },
  { key: 'gallery_images', label: 'Gallery Images', table: 'gallery_images' },
  { key: 'videos', label: 'Videos', table: 'videos' },
  { key: 'testimonials', label: 'Testimonials', table: 'testimonials' },
  { key: 'faqs', label: 'FAQs', table: 'faqs' },
  { key: 'rates', label: 'Rate Plans', table: 'rates' },
  { key: 'addons', label: 'Add-ons', table: 'addons' },
  { key: 'navigation_items', label: 'Navigation Items', table: 'navigation_items' },
  { key: 'media', label: 'Uploaded Images', table: 'media' },
];

const counts = await Promise.all(
  COUNT_TABLES.map(async (t) => {
    const result = await db.execute(`SELECT COUNT(*) AS n FROM ${t.table}`);
    return { ...t, count: Number(result.rows[0]?.n ?? 0) };
  })
);

const comingSoon = [
  'Pages',
  'Navigation',
  'Business Info',
  'Rates & Packages',
  'Events',
  'Gallery',
  'Videos',
  'Testimonials',
  'FAQs',
  'Add-ons',
  'Policies',
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Dashboard — RC Rally Hub Portal</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@600;700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/portal-assets/portal.css" />
  </head>
  <body>
    <div class="portal-shell">
      <div class="portal-topbar">
        <div>
          <div class="portal-eyebrow">RC Rally Hub</div>
          <h1>Admin Portal</h1>
        </div>
        <div class="portal-user">
          <span>Signed in as <strong>{adminUser.username}</strong></span>
          <form method="POST" action="/api/admin/logout">
            <button type="submit">Log Out</button>
          </form>
        </div>
      </div>

      <p class="portal-section-title">Content overview</p>
      <div class="portal-grid">
        {counts.map((c) => (
          <div class="portal-stat-card">
            <div class="portal-stat-value">{c.count}</div>
            <div class="portal-stat-label">{c.label}</div>
          </div>
        ))}
      </div>

      <p class="portal-section-title">Manage content</p>
      <div class="portal-nav-grid">
        {comingSoon.map((label) => (
          <div class="portal-nav-card">
            <span class="portal-nav-card-title">{label}</span>
            <span class="portal-badge">Coming soon</span>
          </div>
        ))}
      </div>
    </div>
  </body>
</html>
