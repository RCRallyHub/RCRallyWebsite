---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import { getDb } from '../../lib/db';

const db = getDb();

const COUNT_TABLES: { key: string; label: string; table: string }[] = [
  { key: 'pages', label: 'Pages', table: 'pages' },
  { key: 'events', label: 'Events', table: 'events' },
  { key: 'gallery_images', label: 'Gallery Images', table: 'gallery_images' },
  { key: 'videos', label: 'Videos', table: 'videos' },
  { key: 'testimonials', label: 'Testimonials', table: 'testimonials' },
  { key: 'faqs', label: 'FAQs', table: 'faqs' },
  { key: 'rates', label: 'Rate Plans', table: 'rates' },
  { key: 'addons', label: 'Add-ons', table: 'addons' },
  { key: 'navigation_items', label: 'Navigation Items', table: 'navigation_items' },
  { key: 'media', label: 'Uploaded Images', table: 'media' },
];

const counts = await Promise.all(
  COUNT_TABLES.map(async (t) => {
    const result = await db.execute(`SELECT COUNT(*) AS n FROM ${t.table}`);
    return { ...t, count: Number(result.rows[0]?.n ?? 0) };
  })
);

const manageLinks: { label: string; href?: string }[] = [
  { label: 'Business Info', href: '/portal/business-info' },
  { label: 'Gallery', href: '/portal/gallery' },
  { label: 'Pages', href: '/portal/pages' },
  { label: 'Navigation', href: '/portal/navigation' },
  { label: 'Rates & Packages', href: '/portal/rates' },
  { label: 'Events', href: '/portal/events' },
  { label: 'Videos', href: '/portal/videos' },
  { label: 'Testimonials', href: '/portal/testimonials' },
  { label: 'FAQs', href: '/portal/faqs' },
  { label: 'Add-ons', href: '/portal/addons' },
  { label: 'Policies', href: '/portal/policies' },
];
---
<PortalLayout title="Dashboard" active="dashboard">
  <p class="portal-section-title">Content overview</p>
  <div class="portal-grid">
    {counts.map((c) => (
      <div class="portal-stat-card">
        <div class="portal-stat-value">{c.count}</div>
        <div class="portal-stat-label">{c.label}</div>
      </div>
    ))}
  </div>

  <p class="portal-section-title">Manage content</p>
  <div class="portal-nav-grid">
    {manageLinks.map((item) =>
      item.href ? (
        <a class="portal-nav-card" href={item.href}>
          <span class="portal-nav-card-title">{item.label}</span>
          <span class="portal-badge is-live">Open</span>
        </a>
      ) : (
        <div class="portal-nav-card">
          <span class="portal-nav-card-title">{item.label}</span>
          <span class="portal-badge">Coming soon</span>
        </div>
      )
    )}
  </div>
</PortalLayout>
