---
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import { getDb } from '../../../lib/db';
import { invalidateCache } from '../../../lib/content/cache';

const db = getDb();

function str(form: FormData, key: string): string | null {
  const v = form.get(key);
  const s = typeof v === 'string' ? v.trim() : '';
  return s ? s : null;
}

function slugify(input: string): string {
  return input.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'rate';
}

async function uniqueSlug(base: string): Promise<string> {
  let candidate = base;
  let n = 1;
  while (true) {
    const existing = await db.execute({ sql: 'SELECT id FROM rates WHERE slug = ? LIMIT 1', args: [candidate] });
    if (existing.rows.length === 0) return candidate;
    n += 1;
    candidate = `${base}-${n}`;
  }
}

let redirectTarget: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  try {
    if (action === 'add-rate') {
      const name = str(form, 'name');
      const price = str(form, 'price');
      const category = str(form, 'category');
      if (!name || !price || !category) throw new Error('Name, price, and category are required.');

      const slug = await uniqueSlug(slugify(name));
      const maxRow = (await db.execute('SELECT COALESCE(MAX(display_order), -1) AS m FROM rates')).rows[0];
      const nextOrder = Number(maxRow?.m ?? -1) + 1;

      await db.execute({
        sql: `INSERT INTO rates
                (slug, name, description, price, billing_unit, peak_or_off_peak, category, display_order)
              VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
        args: [
          slug,
          name,
          str(form, 'description') ?? '',
          price,
          str(form, 'billing_unit') ?? 'per hour',
          str(form, 'peak_or_off_peak') ?? 'n/a',
          category,
          nextOrder,
        ],
      });
      invalidateCache('rates');
      redirectTarget = '/portal/rates?saved=1';
    } else if (action === 'delete-rate') {
      const id = Number(form.get('id'));
      await db.execute({ sql: 'DELETE FROM rates WHERE id = ?', args: [id] }); // rate_features cascades
      invalidateCache('rates');
      redirectTarget = '/portal/rates?saved=1';
    } else if (action === 'move-rate') {
      const id = Number(form.get('id'));
      const direction = String(form.get('direction'));
      const rateRows = (await db.execute('SELECT id, display_order FROM rates ORDER BY display_order, id')).rows;
      const idx = rateRows.findIndex((r) => Number(r.id) === id);
      const swapIdx = direction === 'up' ? idx - 1 : idx + 1;
      if (idx !== -1 && swapIdx >= 0 && swapIdx < rateRows.length) {
        const a = rateRows[idx];
        const b = rateRows[swapIdx];
        await db.execute({ sql: 'UPDATE rates SET display_order = ? WHERE id = ?', args: [b.display_order, a.id] });
        await db.execute({ sql: 'UPDATE rates SET display_order = ? WHERE id = ?', args: [a.display_order, b.id] });
        invalidateCache('rates');
      }
      redirectTarget = '/portal/rates?saved=1';
    } else {
      throw new Error('Unknown action.');
    }
  } catch (err) {
    const message = err instanceof Error ? err.message : 'Something went wrong.';
    redirectTarget = `/portal/rates?error=${encodeURIComponent(message)}`;
  }
}

if (redirectTarget) {
  return Astro.redirect(redirectTarget);
}

const rates = (
  await db.execute(`
    SELECT r.*, (SELECT COUNT(*) FROM rate_features rf WHERE rf.rate_id = r.id) AS feature_count
    FROM rates r
    ORDER BY r.display_order, r.id
  `)
).rows;
---
<PortalLayout title="Rates & Packages" active="rates">
  <div class="portal-card">
    <h2>Rate Plans</h2>
    <p class="portal-card-hint">Open a plan to edit its details and feature list. Deleting a plan also removes its features.</p>

    <div class="portal-list">
      {rates.map((r, i) => (
        <div class:list={['portal-list-row', { 'is-disabled': !r.published }]}>
          <div class="portal-order-btns">
            <form method="POST" class="portal-inline-form">
              <input type="hidden" name="action" value="move-rate" />
              <input type="hidden" name="id" value={String(r.id)} />
              <input type="hidden" name="direction" value="up" />
              <button type="submit" disabled={i === 0} aria-label="Move up">▲</button>
            </form>
            <form method="POST" class="portal-inline-form">
              <input type="hidden" name="action" value="move-rate" />
              <input type="hidden" name="id" value={String(r.id)} />
              <input type="hidden" name="direction" value="down" />
              <button type="submit" disabled={i === rates.length - 1} aria-label="Move down">▼</button>
            </form>
          </div>

          <div class="portal-list-body">
            <div class="portal-list-title">{String(r.name)} — {String(r.price)}</div>
            <div class="portal-list-meta">
              {String(r.category)} · {Number(r.feature_count)} feature{Number(r.feature_count) === 1 ? '' : 's'}
              {!r.published && ' · hidden'}
            </div>
          </div>

          <div class="portal-list-controls">
            <a class="portal-btn-ghost portal-btn-sm" href={`/portal/rates/${r.id}`}>Manage</a>
            <form method="POST" class="portal-inline-form" onsubmit="return confirm('Delete this rate plan and its features?')">
              <input type="hidden" name="action" value="delete-rate" />
              <input type="hidden" name="id" value={String(r.id)} />
              <button type="submit" class="portal-btn-ghost portal-btn-sm portal-btn-danger">Delete</button>
            </form>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="portal-card">
    <h2>Add a Rate Plan</h2>
    <form method="POST">
      <input type="hidden" name="action" value="add-rate" />
      <div class="portal-form-grid">
        <div class="portal-field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required />
        </div>
        <div class="portal-field">
          <label for="price">Price</label>
          <input id="price" name="price" type="text" required placeholder="e.g. ₱350" />
        </div>
        <div class="portal-field">
          <label for="category">Category</label>
          <input id="category" name="category" type="text" required placeholder="e.g. court-rental" />
        </div>
        <div class="portal-field">
          <label for="billing_unit">Billing unit</label>
          <input id="billing_unit" name="billing_unit" type="text" placeholder="per hour" />
        </div>
        <div class="portal-field">
          <label for="peak_or_off_peak">Peak / off-peak</label>
          <select id="peak_or_off_peak" name="peak_or_off_peak">
            <option value="n/a">n/a</option>
            <option value="peak">peak</option>
            <option value="off-peak">off-peak</option>
            <option value="both">both</option>
          </select>
        </div>
        <div class="portal-field is-wide">
          <label for="description">Description</label>
          <input id="description" name="description" type="text" />
        </div>
      </div>
      <div class="portal-actions">
        <button type="submit" class="portal-btn">Add Rate Plan</button>
      </div>
    </form>
  </div>
</PortalLayout>
