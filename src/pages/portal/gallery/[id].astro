---
export const prerender = false;

import PortalLayout from '../../../layouts/PortalLayout.astro';
import { getDb } from '../../../lib/db';
import { invalidateCache } from '../../../lib/content/cache';
import { resolveImageField } from '../../../lib/storage';

const db = getDb();
const sectionId = Number(Astro.params.id);

function str(form: FormData, key: string): string | null {
  const v = form.get(key);
  const s = typeof v === 'string' ? v.trim() : '';
  return s ? s : null;
}

function slugify(input: string): string {
  return (
    input
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-+|-+$/g, '') || 'image'
  );
}

async function uniqueSlug(base: string): Promise<string> {
  let candidate = base;
  let n = 1;
  // Small table, small n of collisions expected — a simple loop is fine.
  while (true) {
    const existing = await db.execute({ sql: 'SELECT id FROM gallery_images WHERE slug = ? LIMIT 1', args: [candidate] });
    if (existing.rows.length === 0) return candidate;
    n += 1;
    candidate = `${base}-${n}`;
  }
}

if (!Number.isFinite(sectionId)) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

let redirectTarget: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const base = `/portal/gallery/${sectionId}`;

  try {
    if (action === 'edit-section') {
      const title = str(form, 'title');
      if (!title) throw new Error('Title is required.');
      await db.execute({
        sql: 'UPDATE gallery_sections SET title = ?, description = ?, enabled = ?, updated_at = unixepoch() WHERE id = ?',
        args: [title, str(form, 'description'), form.has('enabled') ? 1 : 0, sectionId],
      });
      invalidateCache('gallery');
      redirectTarget = `${base}?saved=1`;
    } else if (action === 'delete-section') {
      const countRow = (
        await db.execute({ sql: 'SELECT COUNT(*) AS n FROM gallery_images WHERE section_id = ?', args: [sectionId] })
      ).rows[0];
      if (Number(countRow?.n ?? 0) > 0) {
        throw new Error('This section still has photos in it — move or delete them first.');
      }
      await db.execute({ sql: 'DELETE FROM gallery_sections WHERE id = ?', args: [sectionId] });
      invalidateCache('gallery');
      redirectTarget = '/portal/gallery?saved=1';
    } else if (action === 'add-image') {
      const title = str(form, 'title');
      const alt = str(form, 'alt');
      if (!title || !alt) throw new Error('Title and alt text are required.');
      const imageUrl = await resolveImageField(form, 'image_url', { altText: alt, title });
      if (!imageUrl) throw new Error('An image (uploaded or pasted path/URL) is required.');
      const thumbnailUrl = await resolveImageField(form, 'thumbnail_url');

      const slug = await uniqueSlug(slugify(title));
      const maxRow = (
        await db.execute({
          sql: 'SELECT COALESCE(MAX(display_order), -1) AS m FROM gallery_images WHERE section_id = ?',
          args: [sectionId],
        })
      ).rows[0];
      const nextOrder = Number(maxRow?.m ?? -1) + 1;

      await db.execute({
        sql: `INSERT INTO gallery_images
                (slug, section_id, image_url, thumbnail_url, title, caption, alt, image_date, display_order, featured, published)
              VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
        args: [
          slug,
          sectionId,
          imageUrl,
          thumbnailUrl,
          title,
          str(form, 'caption'),
          alt,
          str(form, 'image_date'),
          nextOrder,
          form.has('featured') ? 1 : 0,
          form.has('published') ? 1 : 0,
        ],
      });
      invalidateCache('gallery');
      redirectTarget = `${base}?saved=1`;
    } else if (action === 'edit-image') {
      const id = Number(form.get('id'));
      const title = str(form, 'title');
      const alt = str(form, 'alt');
      if (!title || !alt) throw new Error('Title and alt text are required.');
      const imageUrl = await resolveImageField(form, 'image_url', { altText: alt, title });
      if (!imageUrl) throw new Error('An image (uploaded or pasted path/URL) is required.');
      const thumbnailUrl = await resolveImageField(form, 'thumbnail_url');

      await db.execute({
        sql: `UPDATE gallery_images SET
                image_url = ?, thumbnail_url = ?, title = ?, caption = ?, alt = ?, image_date = ?,
                featured = ?, published = ?, updated_at = unixepoch()
              WHERE id = ? AND section_id = ?`,
        args: [
          imageUrl,
          thumbnailUrl,
          title,
          str(form, 'caption'),
          alt,
          str(form, 'image_date'),
          form.has('featured') ? 1 : 0,
          form.has('published') ? 1 : 0,
          id,
          sectionId,
        ],
      });
      invalidateCache('gallery');
      redirectTarget = `${base}?saved=1`;
    } else if (action === 'delete-image') {
      const id = Number(form.get('id'));
      await db.execute({ sql: 'DELETE FROM gallery_images WHERE id = ? AND section_id = ?', args: [id, sectionId] });
      invalidateCache('gallery');
      redirectTarget = `${base}?saved=1`;
    } else if (action === 'move-image') {
      const id = Number(form.get('id'));
      const direction = String(form.get('direction'));
      const images = (
        await db.execute({
          sql: 'SELECT id, display_order FROM gallery_images WHERE section_id = ? ORDER BY display_order, id',
          args: [sectionId],
        })
      ).rows;
      const idx = images.findIndex((r) => Number(r.id) === id);
      const swapIdx = direction === 'up' ? idx - 1 : idx + 1;
      if (idx !== -1 && swapIdx >= 0 && swapIdx < images.length) {
        const a = images[idx];
        const b = images[swapIdx];
        await db.execute({ sql: 'UPDATE gallery_images SET display_order = ? WHERE id = ?', args: [b.display_order, a.id] });
        await db.execute({ sql: 'UPDATE gallery_images SET display_order = ? WHERE id = ?', args: [a.display_order, b.id] });
        invalidateCache('gallery');
      }
      redirectTarget = `${base}?saved=1`;
    } else {
      throw new Error('Unknown action.');
    }
  } catch (err) {
    const message = err instanceof Error ? err.message : 'Something went wrong.';
    redirectTarget = `${base}?error=${encodeURIComponent(message)}`;
  }
}

if (redirectTarget) {
  return Astro.redirect(redirectTarget);
}

const section = (
  await db.execute({ sql: 'SELECT * FROM gallery_sections WHERE id = ?', args: [sectionId] })
).rows[0];

if (!section) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}

const images = (
  await db.execute({
    sql: 'SELECT * FROM gallery_images WHERE section_id = ? ORDER BY display_order, id',
    args: [sectionId],
  })
).rows;

const imageCount = images.length;
---
<PortalLayout title={`Gallery — ${String(section.title)}`} active="gallery">
  <p class="portal-breadcrumb"><a href="/portal/gallery">← All Sections</a></p>

  <div class="portal-card">
    <h2>Section Details</h2>
    <form method="POST">
      <input type="hidden" name="action" value="edit-section" />
      <div class="portal-form-grid">
        <div class="portal-field">
          <label for="title">Title</label>
          <input id="title" name="title" type="text" required value={String(section.title)} />
        </div>
        <div class="portal-field is-wide">
          <label for="description">Description</label>
          <input id="description" name="description" type="text" value={section.description ? String(section.description) : ''} />
        </div>
        <div class="portal-field">
          <label>&nbsp;</label>
          <label class="portal-checkbox">
            <input type="checkbox" name="enabled" checked={!!section.enabled} />
            Visible on site
          </label>
        </div>
      </div>
      <div class="portal-actions">
        <button type="submit" class="portal-btn">Save Section</button>
      </div>
    </form>

    <form method="POST" style="margin-top: 14px;" onsubmit="return confirm('Delete this empty section?')">
      <input type="hidden" name="action" value="delete-section" />
      <button type="submit" class="portal-btn-ghost portal-btn-sm portal-btn-danger" disabled={imageCount > 0}>
        Delete Section{imageCount > 0 && ` (remove ${imageCount} photo${imageCount === 1 ? '' : 's'} first)`}
      </button>
    </form>
  </div>

  <div class="portal-card">
    <h2>Photos ({imageCount})</h2>
    <div class="portal-list">
      {images.map((img, i) => (
        <div class:list={['portal-list-row', { 'is-disabled': !img.published }]} style="align-items: flex-start;">
          <div class="portal-order-btns">
            <form method="POST" class="portal-inline-form">
              <input type="hidden" name="action" value="move-image" />
              <input type="hidden" name="id" value={String(img.id)} />
              <input type="hidden" name="direction" value="up" />
              <button type="submit" disabled={i === 0} aria-label="Move up">▲</button>
            </form>
            <form method="POST" class="portal-inline-form">
              <input type="hidden" name="action" value="move-image" />
              <input type="hidden" name="id" value={String(img.id)} />
              <input type="hidden" name="direction" value="down" />
              <button type="submit" disabled={i === images.length - 1} aria-label="Move down">▼</button>
            </form>
          </div>

          <img class="portal-list-thumb" src={String(img.image_url)} alt="" loading="lazy" />

          <form method="POST" class="portal-list-body" enctype="multipart/form-data">
            <input type="hidden" name="action" value="edit-image" />
            <input type="hidden" name="id" value={String(img.id)} />
            <div class="portal-form-grid">
              <div class="portal-field">
                <label>Title</label>
                <input name="title" type="text" required value={String(img.title)} />
              </div>
              <div class="portal-field">
                <label>Image (path/URL, or upload to replace)</label>
                <input name="image_url" type="text" value={String(img.image_url)} />
                <input name="image_url_upload" type="file" accept="image/*" style="font-size:0.76rem; margin-top:4px;" />
              </div>
              <div class="portal-field">
                <label>Thumbnail (optional — path/URL, or upload)</label>
                <input name="thumbnail_url" type="text" value={img.thumbnail_url ? String(img.thumbnail_url) : ''} />
                <input name="thumbnail_url_upload" type="file" accept="image/*" style="font-size:0.76rem; margin-top:4px;" />
              </div>
              <div class="portal-field">
                <label>Alt text</label>
                <input name="alt" type="text" required value={String(img.alt)} />
              </div>
              <div class="portal-field is-wide">
                <label>Caption</label>
                <input name="caption" type="text" value={img.caption ? String(img.caption) : ''} />
              </div>
              <div class="portal-field">
                <label>Date (optional)</label>
                <input name="image_date" type="text" value={img.image_date ? String(img.image_date) : ''} placeholder="YYYY-MM-DD" />
              </div>
              <div class="portal-field">
                <label>&nbsp;</label>
                <label class="portal-checkbox">
                  <input type="checkbox" name="featured" checked={!!img.featured} />
                  Featured
                </label>
                <label class="portal-checkbox">
                  <input type="checkbox" name="published" checked={!!img.published} />
                  Visible on site
                </label>
              </div>
            </div>
            <div class="portal-actions">
              <button type="submit" class="portal-btn portal-btn-sm">Save</button>
            </div>
          </form>

          <form method="POST" class="portal-inline-form" onsubmit="return confirm('Delete this photo?')">
            <input type="hidden" name="action" value="delete-image" />
            <input type="hidden" name="id" value={String(img.id)} />
            <button type="submit" class="portal-btn-ghost portal-btn-sm portal-btn-danger">Delete</button>
          </form>
        </div>
      ))}
      {imageCount === 0 && <p class="portal-card-hint">No photos in this section yet.</p>}
    </div>
  </div>

  <div class="portal-card">
    <h2>Add a Photo</h2>
    <p class="portal-card-hint">
      Upload a photo, or paste a path to an existing image already in the repo (e.g. <code>/images/gallery/example.webp</code>).
    </p>
    <form method="POST" enctype="multipart/form-data">
      <input type="hidden" name="action" value="add-image" />
      <div class="portal-form-grid">
        <div class="portal-field">
          <label for="new_title">Title</label>
          <input id="new_title" name="title" type="text" required />
        </div>
        <div class="portal-field">
          <label for="new_image_url">Image (path/URL, or upload below)</label>
          <input id="new_image_url" name="image_url" type="text" />
          <input name="image_url_upload" type="file" accept="image/*" style="font-size:0.76rem; margin-top:4px;" />
        </div>
        <div class="portal-field">
          <label for="new_thumbnail_url">Thumbnail (optional — path/URL, or upload)</label>
          <input id="new_thumbnail_url" name="thumbnail_url" type="text" />
          <input name="thumbnail_url_upload" type="file" accept="image/*" style="font-size:0.76rem; margin-top:4px;" />
        </div>
        <div class="portal-field">
          <label for="new_alt">Alt text</label>
          <input id="new_alt" name="alt" type="text" required />
        </div>
        <div class="portal-field is-wide">
          <label for="new_caption">Caption</label>
          <input id="new_caption" name="caption" type="text" />
        </div>
        <div class="portal-field">
          <label for="new_image_date">Date (optional)</label>
          <input id="new_image_date" name="image_date" type="text" placeholder="YYYY-MM-DD" />
        </div>
        <div class="portal-field">
          <label>&nbsp;</label>
          <label class="portal-checkbox">
            <input type="checkbox" name="featured" />
            Featured
          </label>
          <label class="portal-checkbox">
            <input type="checkbox" name="published" checked />
            Visible on site
          </label>
        </div>
      </div>
      <div class="portal-actions">
        <button type="submit" class="portal-btn">Add Photo</button>
      </div>
    </form>
  </div>
</PortalLayout>
